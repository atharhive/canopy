<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="?colorSurfaceVariant">

    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/icon_large"
        android:contentDescription="@string/app_name" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/demo_title"
        android:textColor="?colorPrimary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/demo_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/demo_description"
        android:textColor="@color/surface_light"
        android:textSize="16sp" />

    <Switch
        android:id="@+id/demo_detection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/detection_enabled"
        android:textColor="@color/surface_light" />

    <Switch
        android:id="@+id/demo_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/spoken_summaries"
        android:textColor="@color/surface_light" />

    <Switch
        android:id="@+id/demo_tts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/text_to_speech"
        android:textColor="@color/surface_light" />

    <Button
        android:id="@+id/play_demo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/play_demo"
        android:textColor="?colorSurfaceVariant"
        android:backgroundTint="?colorPrimary" />

    <TextView
        android:id="@+id/demo_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="@color/surface_light"
        android:textSize="20sp"
        android:visibility="gone" />
</LinearLayout>
