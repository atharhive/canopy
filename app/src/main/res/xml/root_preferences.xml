<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <Preference
        android:key="reset"
        android:layout="@layout/reset_button"/>

    <SwitchPreferenceCompat
        android:title="@string/detection_enabled"
        android:summary="@string/detection_enabled_summary"
        android:key="detection_enabled"
        android:defaultValue="true" />

    <SwitchPreferenceCompat
        android:title="@string/spoken_summaries"
        android:summary="@string/spoken_summaries_summary"
        android:key="spoken_summaries"
        android:defaultValue="true" />

    <SwitchPreferenceCompat
        android:title="@string/text_to_speech"
        android:summary="@string/text_to_speech_summary"
        android:key="text_to_speech"
        android:defaultValue="true" />

    <SwitchPreferenceCompat
        android:title="@string/gemma_enabled"
        android:summary="@string/gemma_enabled_summary"
        android:key="gemma_enabled"
        android:defaultValue="false"
        />

    <Preference
        android:key="gemma_download"
        android:title="@string/gemma_download"
        android:summary="@string/gemma_download_summary" />

    <SwitchPreferenceCompat
        android:title="@string/high_contrast_theme"
        android:key="theme"
        android:defaultValue="false"
        />

    <SwitchPreferenceCompat
        android:title="@string/show_spectrogram"
        android:key="show_spectrogram"
        android:summary="@string/summary_show_spectrogram"
        android:defaultValue="false"/>

    <SwitchPreferenceCompat
        android:title="@string/show_images"
        android:key="show_images"
        android:defaultValue="false"/>

    <ListPreference
        app:defaultValue="9"
        app:entries="@array/audio_source_entries"
        app:entryValues="@array/audio_source_values"
        app:key="audio_source"
        app:title="@string/settings_audiosource"
        app:useSimpleSummaryProvider="true" />

    <SwitchPreference
        android:key="bluetooth"
        android:title="@string/bluetooth_connection"
        android:defaultValue="false"/>

    <org.tensorflow.lite.examples.soundclassifier.EditTextSeekBarPreference
        android:title="@string/settings_highpass"
        android:key="high_pass"
        android:max="1000"
        android:defaultValue="0"
        app:showSeekBarValue="true"
        />

    <org.tensorflow.lite.examples.soundclassifier.EditTextSeekBarPreference
        android:title="@string/settings_threshold"
        android:key="model_threshold"
        android:max="100"
        android:defaultValue="30"
        app:showSeekBarValue="true"
        />

    <SwitchPreferenceCompat
        android:title="@string/settings_meta_extended"
        android:key="meta_extended"
        android:summary="@string/summary_meta_extended"
        android:defaultValue="true"
        />

    <SwitchPreferenceCompat
        android:title="@string/settings_notification_sound"
        android:key="play_sound"
        android:defaultValue="false"
        />

    <SwitchPreferenceCompat
        android:title="@string/save_wav"
        android:summary="@string/summary_save_wav"
        android:key="write_wav"
        android:defaultValue="false"
        />

    <org.woheller69.preferences.EditTextSwitchPreference
        android:selectable="true"
        app:useSimpleSummaryProvider="true"
        android:key="manual_location_value"
        app:SwitchKey="manual_location"
        app:SwitchKeyDefaultValue="false"
        android:defaultValue="0.000/0.000"
        android:title="@string/manual_location" />

    <Preference
        android:key="language"
        android:layout="@layout/language_button"/>

</PreferenceScreen>